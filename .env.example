# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Enrichment Provider API Keys
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
SEARCH_API_KEY="your-search-api-key"
BRAVE_SEARCH_API_KEY="your-brave-search-api-key"
ENFORMION_AP_NAME="your-enformion-access-profile-name"
ENFORMION_AP_PASSWORD="your-enformion-access-profile-password"

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000


# SEC EDGAR public-company/business entity adapter.
# Required by SEC fair-access policy for automated requests.
# Use a truthful identifying string with a monitored contact, e.g.
# SEC_USER_AGENT="AtlasVerify your-contact@example.com"
SEC_USER_AGENT=""

# CourtListener / Free Law Project API token for court-record search.
COURTLISTENER_API_TOKEN=""

# OpenCorporates API token for broader company/entity registry search.
# Keep this server-side; the provider sends it via X-API-TOKEN.
OPENCORPORATES_API_TOKEN=""

# ATTOM licensed U.S. property data API key. Keep server-side.
ATTOM_API_KEY=""
