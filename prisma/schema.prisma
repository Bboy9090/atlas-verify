generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  name          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  cases         Case[]
  auditLogs     AuditLog[]
  evidenceDisputes EvidenceDispute[]
  reviewedSuppressionRequests SuppressionRequest[] @relation("SuppressionReviewer")
}

model Case {
  id          String    @id @default(uuid())
  title       String
  description String?
  status      String    @default("open") // 'open' | 'in-progress' | 'closed'
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects    Subject[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([status])
}

model Subject {
  id                String              @id @default(uuid())
  fullName          String
  phoneE164         String?
  email             String?
  username          String?
  address           String?
  city              String?
  state             String?
  notes             String?
  caseId            String
  case              Case                @relation(fields: [caseId], references: [id], onDelete: Cascade)
  enrichmentResults EnrichmentResult[]
  auditLogs         AuditLog[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([caseId])
  @@index([username])
}

model EnrichmentResult {
  id              String   @id @default(uuid())
  subjectId       String
  subject         Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  provider        String
  providerType    String   // 'phone_lookup' | 'web_search'
  payload         Json     @db.JsonB
  confidenceScore Float    @default(0)
  timestamp       DateTime @default(now())
  evidenceFacts   EvidenceFact[]

  @@index([subjectId])
  @@index([provider])
}

model EvidenceFact {
  id                  String           @id @default(uuid())
  enrichmentResultId  String
  enrichmentResult    EnrichmentResult @relation(fields: [enrichmentResultId], references: [id], onDelete: Cascade)
  field               String
  value               Json             @db.JsonB
  sourceName          String
  sourceType          String?
  sourceUrl           String?
  sourceLocator       String?
  normalizedValue     String?
  rawRecordHash       String?
  legalBasis          String?
  retrievedAt         DateTime
  observedAt          DateTime?
  confidenceScore     Float            @default(0)
  corroborationCount  Int              @default(0)
  conflictCount       Int              @default(0)
  metadata            Json?            @db.JsonB
  createdAt           DateTime         @default(now())
  disputes            EvidenceDispute[]

  @@index([enrichmentResultId])
  @@index([field])
  @@index([sourceName])
  @@index([sourceType])
  @@index([rawRecordHash])
  @@index([retrievedAt])
}


model EvidenceDispute {
  id              String       @id @default(uuid())
  evidenceFactId  String
  evidenceFact    EvidenceFact @relation(fields: [evidenceFactId], references: [id], onDelete: Cascade)
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          String       @default("open") // 'open' | 'resolved' | 'rejected'
  reason          String
  requestedValue  Json?        @db.JsonB
  resolutionNote  String?
  resolvedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([evidenceFactId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}


model SuppressionRequest {
  id               String    @id @default(uuid())
  requestTokenHash String    @unique
  identifierType   String
  identifierHash   String
  identifierHint   String?
  contactEmail     String
  status           String    @default("pending") // 'pending' | 'approved' | 'rejected'
  verificationNote String?
  resolutionNote   String?
  reviewedById     String?
  reviewedBy       User?     @relation("SuppressionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([identifierType, identifierHash])
  @@index([status])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  metadata  Json     @db.JsonB
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([subjectId])
  @@index([action])
}
